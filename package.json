{
  "name": "ai-calling-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Calling Agent — multi-tenant, white-label, provider-agnostic AI voice calling SaaS. Monorepo root (npm workspaces).",
  "workspaces": [
    "apps/*",
    "db"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "migrate": "npm run migrate -w db"
  }
}
