# Copy to .env.local (apps/web) and/or export before running db/migrate.js.
# Never commit a file with real values — only this .env.example is tracked.

# --- Database -----------------------------------------------------------
# Connection the Next.js app uses at runtime. MUST authenticate as the
# `app_user` Postgres role created by db/migrations/001_extensions_and_core.sql
# (a non-superuser, NOBYPASSRLS role) — never the migration/superuser role —
# so Row Level Security tenant-isolation policies are actually enforced.
# Local dev default matches docker/local Postgres setup in README.md.
DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:5432/ai_calling_agent

# Connection used ONLY by `npm run migrate` (db/migrate.js) to create
# tables, RLS policies, and the app_user role itself. Must be a superuser
# or a role with CREATEROLE + ownership of the target database — typically
# the default `postgres` role in local dev. Never used by the running app.
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/ai_calling_agent

# --- docker-compose.prod.yml only (VPS deployment — see deploy/RUNBOOK.md) --
# Not read by the app directly; docker-compose.prod.yml plugs these into
# DATABASE_URL/DATABASE_URL_MIGRATE for the `web`/`voice-gateway`/`migrate`
# containers so a plain `docker compose up` never needs a real password
# typed into a command line. Leave unset for local (non-Docker) dev.
# APP_DB_PASSWORD=
# POSTGRES_SUPERUSER_PASSWORD=

# --- Auth -----------------------------------------------------------------
# No third-party auth provider keys are needed for Phase 1 — auth is a
# hand-rolled email/password + server-side session implementation
# (see docs/PHASE1_DECISIONS.md for why). Session cookies are signed
# implicitly by being server-side lookups (random 32-byte tokens), so there
# is no separate "auth secret" env var to set in Phase 1.

# --- Node/Next --------------------------------------------------------------
NODE_ENV=development

# --- Provider Registry (Phase 2) -------------------------------------------
# Symmetric key used to encrypt/decrypt tenant_provider_config.config
# (per-tenant provider credentials — Plivo auth tokens, FreJun Teler API
# keys, etc). See apps/web/lib/providers/crypto.ts and
# docs/PROVIDER_REGISTRY.md "Secrets". NEVER a real production key here —
# generate one per environment (e.g. `openssl rand -hex 32`) and store it in
# your deployment platform's secret store, not in a committed .env file.
# TODO(infra): replace with a real secrets manager/KMS before onboarding
# real tenant telephony credentials — this env-var key is the Phase 2
# minimum bar, not the final design.
PROVIDER_CONFIG_ENCRYPTION_KEY=dev-only-change-me-32-bytes-minimum

# --- Phase 2/3 provider credentials (per-tenant, NOT global) ----------------
# Real Plivo/FreJun Teler/etc credentials are never env vars in this app —
# they live per-tenant in tenant_provider_config.config (encrypted, see
# above), inserted via an internal admin tool, never a migration/seed file.
# These lines exist only so `npm run dev` locally can smoke-test the
# `/api/calls/webhook/[providerKey]` route path without any real vendor
# account; leave unset otherwise.
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# FREJUN_TELER_API_KEY=
# SARVAM_API_KEY=
# GEMINI_API_KEY=

# --- Phase 3: services/voice-gateway (Python) -------------------------------
# This is a SEPARATE runtime/process from apps/web — see
# services/voice-gateway/README.md for how to run it standalone. It shares
# the SAME Postgres database as apps/web (same DATABASE_URL above) and the
# SAME PROVIDER_CONFIG_ENCRYPTION_KEY (both runtimes must decrypt the same
# tenant_provider_config.config envelopes — see voice_gateway/crypto.py,
# a byte-for-byte port of apps/web/lib/providers/crypto.ts). Copy this file
# to services/voice-gateway/.env and export before running pytest/the demo.
#
# Real per-tenant STT/TTS/LLM API keys are, like Phase 2's telephony keys,
# NEVER env vars — they live in tenant_provider_config.config (encrypted),
# inserted via an internal admin tool. The vars below exist only for local
# smoke-testing a single adapter directly against a live vendor API without
# going through the registry/DB at all; leave unset otherwise.
# SARVAM_API_KEY=
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# PIPER_BASE_URL=http://localhost:5001   # self-hosted Piper HTTP wrapper — see tts/adapters/piper.py's GPL-3.0 license caveat before deploying this one

# --- Phase 6: job queue -----------------------------------------------------
# Chooses the job queue backend behind lib/queue/index.ts's getJobQueue() —
# see db/migrations/011_phase6_whatsapp_appointments_campaigns_compliance.sql
# for the "Postgres by default, BullMQ+Redis is the documented production
# target once a managed Redis instance is provisioned" reasoning.
QUEUE_BACKEND=pg
# Only read when QUEUE_BACKEND=bullmq.
# REDIS_URL=redis://localhost:6379

# --- Phase 6: n8n control-plane webhooks -------------------------------------
# Shared secret every apps/web/app/api/webhooks/n8n/*/route.ts endpoint
# checks against the `x-n8n-webhook-token` header (lib/webhooks/n8n-auth.ts).
# NEVER a real production value here — see docs/N8N_WORKFLOWS.md's "Deferred"
# section for why this is a Phase 6 minimum (one shared secret, not yet a
# per-tenant token) and its required n8n-side environment variables.
N8N_WEBHOOK_SHARED_SECRET=dev-only-change-me

# --- Phase 6: WhatsApp Provider Registry (per-tenant, NOT global) -----------
# Like telephony/STT/TTS/LLM credentials, real Interakt/Gupshup credentials
# are never env vars — they live in tenant_provider_config.config
# (encrypted), layer='whatsapp'. See docs/VERIFICATION.md §10 and
# docs/PROVIDER_REGISTRY.md.
# INTERAKT_API_KEY=
# INTERAKT_WABA_ID=

# --- Phase 8: Reseller & white-label domain routing --------------------------
# The base domain below which every {reseller-slug}.<this> host resolves to
# that reseller's branding (apps/web/lib/reseller/branding.ts's
# resolveTenantBranding/extractSubdomain). Public (client-readable) since it
# only shapes which host-header pattern is treated as a reseller subdomain,
# not a secret. See docs/RESELLER_HIERARCHY.md "Domain routing" for the real
# custom-domain (DNS/SSL/reverse-proxy) follow-up this does NOT cover yet.
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=yourplatform.example
